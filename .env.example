# API key for the OpenAI-compatible endpoint that runs the reasoning model, e.g. from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-REPLACE_ME

# OpenAI-compatible endpoint. Hosted by default; use http://localhost:8000/v1 for a self-hosted NIM or vLLM.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model roles
SCI_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
SCI_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
SCI_THINKING=false
SCI_TEMPERATURE=0.2
SCI_MAX_TOKENS=4096

# BioNeMo biology NIMs. Only needed for real design runs (--real-bio).
# Hosted: a key from build.nvidia.com (reuses NVIDIA_API_KEY if NGC_API_KEY is unset).
# NGC_API_KEY=nvapi-REPLACE_ME
# Self-hosted: point at your running NIM(s); leave unset to use the hosted endpoint.
# BIONEMO_BASE_URL=http://localhost:8000
